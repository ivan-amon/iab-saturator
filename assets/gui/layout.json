{
  "meta": {
    "name": "IAB-Saturator GUI layout",
    "version": 2,
    "units": "px at 1x; origin top-left; y grows down; angles in degrees, 0 = 12 o'clock, positive = clockwise",
    "panel": {
      "w": 840,
      "h": 500
    },
    "render_scale": 2,
    "render_size": {
      "w": 1680,
      "h": 1000
    },
    "source": "Measured on mockup 'Interfaz_Saturator_Curves_en_Beige.png' (panel 1529x928 px scaled to 840x500), rounded to integer px, snapped to main axis x=520 and the sidebar axis (sidebar centre). Clearances (labels vs LEDs, VU labels vs ticks, sidebar width, footer) are solved by formula in gen_layout.py.",
    "blender_mapping": "1 Blender unit = 1 px. Blender X = x, Blender Y = -y, Z up; panel surface at Z = 0.",
    "sprite_convention": "Every sprite is centred on its element's (cx, cy) and covers its 'sprite' box at 1x; PNG size = sprite box x render_scale. Rotating sprites rotate about their centre.",
    "text_convention": "Roboto Slab. 'x' is the anchor x (start/middle/end), 'cy' the vertical centre of the cap-height block (all lines). 'box' is the measured ink box from font advances (kerning ignored). Lines are separated by line_height_em x size."
  },
  "palette": {
    "cream": "#d5cbb1",
    "ink": "#292824",
    "rust": "#a44735",
    "mustard": "#d69a35",
    "olive": "#77796c",
    "_note": "Brand palette (logo, web). The GUI uses 'colors'."
  },
